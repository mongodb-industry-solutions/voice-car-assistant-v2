// ObjectBox FlatBuffers Schema for Conversation History
// This schema defines the structure for storing conversation messages
// that will be synced to MongoDB Atlas

// A single message in a conversation (user question or assistant answer)
table Conversation {
    id: ulong;                    // Auto-generated unique ID
    conversation_id: string;      // UUID grouping messages in same conversation
    user_id: string;              // Browser session ID
    timestamp: long;              // Unix timestamp (milliseconds)
    role: string;                 // "user" or "assistant"
    message: string;              // The actual message text
    sources: string (optional);   // JSON array of source chunks (assistant only)
    created_at: long;             // Record creation timestamp
}
