// Telemetry data schema for ObjectBox
// Run: flatc --cpp --gen-object-api --gen-compare --cpp-std c++17 schema.fbs

namespace telemetry;

table TelemetrySnapshot {
  id:long;
  timestamp:long;              // Unix timestamp (milliseconds)
  vehicle_id:string;           // VIN number
  telemetry_json:string;       // Full JSON snapshot
  anomaly_count:int;           // Number of warnings/critical sensors
  syncClock:long;              // Managed by ObjectBox Sync
}
